# Server Port
PORT=5000

# MongoDB Connection String (fallback file-backed storage active if offline)
MONGODB_URI=mongodb://127.0.0.1:27017/siddhivinayak_cakes

# JWT Signing Secret (replace with 32+ character random key in production)
JWT_SECRET=your_jwt_secret_key_change_in_production

# Initial Store Owner / Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

